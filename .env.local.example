# Copy to .env.local and fill in when your keys arrive.

# YouCam API (Perfect Corp). When absent, the app runs in DEMO_MODE with
# recorded fixtures so the whole pipeline works without a key.
#
# You were issued TWO values:
#   - API Key  (client_id)     -> this is the V2 Bearer token. Put it here.
#   - Secret key (client_secret, starts with "sk...") -> YOUCAM_SECRET_KEY below.
# V2 endpoints (the ones we use) auth with the API Key directly; the secret is
# only for the legacy V1 id_token flow. Not sure which is which? Fill both and
# run `npm run probe` — it auto-detects the working Bearer token.
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# fal.ai key. When absent, garment perception + generation use demo fallbacks.
FAL_KEY=

# Force demo mode even if keys are present (useful for offline demos).
# DEMO_MODE=1

# Soft cap on YouCam units spent per server process.
UNIT_BUDGET=300
